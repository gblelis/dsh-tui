{
  "name": "dsh-tui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Terminal front end for DeepSeek Harness, packaged as an out-of-tree profile bundle",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint packages tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "compat": "tsx scripts/verify-compat.ts",
    "verify:package": "tsx scripts/check-package.ts",
    "release:build": "pnpm build && tsx scripts/check-package.ts",
    "smoke:screen": "tsx scripts/screen-smoke.ts",
    "smoke:chat": "tsx scripts/chat-smoke.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@deepseek-ai/dsh-llm-mock-server": "0.2.2-rc.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@xterm/headless": "5.5.0",
    "oxlint": "1.81.0",
    "publint": "^0.3.25",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  }
}
